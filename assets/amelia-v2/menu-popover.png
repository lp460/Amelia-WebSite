<svg xmlns="http://www.w3.org/2000/svg" width="760" height="920" viewBox="0 0 760 920"><defs><linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#f5f3fb"/><stop offset="1" stop-color="#e7e2f2"/></linearGradient><filter id="s" x="-20%" y="-20%" width="140%" height="140%"><feDropShadow dx="0" dy="24" stdDeviation="28" flood-color="#2a2440" flood-opacity=".18"/></filter></defs><rect width="760" height="920" fill="url(#bg)"/><g filter="url(#s)"><rect x="110" y="70" width="540" height="780" rx="28" fill="#fff" stroke="#ddd8ea"/><rect x="138" y="100" width="48" height="48" rx="15" fill="#755be8"/><text x="162" y="132" text-anchor="middle" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif" font-size="24" font-weight="700" fill="white">A</text><text x="205" y="119" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif" font-size="19" font-weight="700" fill="#18161e">Amelia</text><text x="205" y="142" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif" font-size="13" fill="#77717f">whisper-large-v3-turbo</text><rect x="520" y="108" width="92" height="30" rx="15" fill="#e9f7f0"/><circle cx="539" cy="123" r="5" fill="#29a873"/><text x="555" y="128" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif" font-size="12" font-weight="700" fill="#20865d">Warm</text><line x1="138" y1="170" x2="622" y2="170" stroke="#ece9f1"/><text x="138" y="205" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif" font-size="12" font-weight="700" fill="#817b88">CIBLE DE DICTÉE</text><rect x="138" y="220" width="484" height="58" rx="14" fill="#f8f7fb" stroke="#ece9f1"/><circle cx="168" cy="249" r="15" fill="#e8e4f8"/><text x="195" y="246" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif" font-size="14" font-weight="700" fill="#18161e">Mail</text><text x="195" y="264" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif" font-size="12" fill="#817b88">Le texte sera inséré ici</text><text x="138" y="320" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif" font-size="12" font-weight="700" fill="#817b88">CONTRÔLES RAPIDES</text><g font-family="-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif"><rect x="138" y="338" width="150" height="52" rx="13" fill="#f8f7fb" stroke="#ece9f1"/><text x="153" y="359" font-size="11" fill="#817b88">Langue</text><text x="153" y="378" font-size="13" font-weight="700" fill="#18161e">Français</text><rect x="304" y="338" width="150" height="52" rx="13" fill="#f8f7fb" stroke="#ece9f1"/><text x="319" y="359" font-size="11" fill="#817b88">Mode</text><text x="319" y="378" font-size="13" font-weight="700" fill="#18161e">Push-to-Talk</text><rect x="470" y="338" width="152" height="52" rx="13" fill="#f8f7fb" stroke="#ece9f1"/><text x="485" y="359" font-size="11" fill="#817b88">Performance</text><text x="485" y="378" font-size="13" font-weight="700" fill="#18161e">Équilibré</text></g><text x="138" y="438" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif" font-size="12" font-weight="700" fill="#817b88">DERNIÈRES DICTÉES</text><g font-family="-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif"><rect x="138" y="456" width="484" height="82" rx="14" fill="#faf9fc" stroke="#ece9f1"/><text x="153" y="481" font-size="13" font-weight="700" fill="#18161e">“Bonjour, je vous confirme que…”</text><text x="153" y="502" font-size="11" fill="#817b88">Mail · il y a 2 min</text><text x="510" y="516" font-size="12" fill="#755be8">Copier · Réinsérer</text><rect x="138" y="550" width="484" height="82" rx="14" fill="#faf9fc" stroke="#ece9f1"/><text x="153" y="575" font-size="13" font-weight="700" fill="#18161e">“Ajoute une validation avant…”</text><text x="153" y="596" font-size="11" fill="#817b88">Xcode · il y a 8 min</text><text x="510" y="610" font-size="12" fill="#755be8">Copier · Réinsérer</text><rect x="138" y="644" width="484" height="82" rx="14" fill="#faf9fc" stroke="#ece9f1"/><text x="153" y="669" font-size="13" font-weight="700" fill="#18161e">“Idée : simplifier l’onboarding…”</text><text x="153" y="690" font-size="11" fill="#817b88">Notes · il y a 15 min</text><text x="510" y="704" font-size="12" fill="#755be8">Copier · Réinsérer</text></g><line x1="138" y1="752" x2="622" y2="752" stroke="#ece9f1"/><text x="150" y="792" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif" font-size="13" font-weight="700" fill="#18161e">Préférences…</text><text x="572" y="792" font-family="SFMono-Regular,Menlo,monospace" font-size="12" fill="#817b88">⌘,</text><text x="150" y="822" font-family="-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif" font-size="13" fill="#ef5d66">Quitter Amelia</text></g></svg>